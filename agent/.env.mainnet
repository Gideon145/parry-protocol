# ── X Layer MAINNET env (Chain ID 196) ─────────────────────────────────────
# Copy to agent/.env after mainnet deploy

OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase

PRIVATE_KEY=0x...          # same wallet used for deploy
AGENT_WALLET=0x...         # same wallet address

# Fill from contracts/deployments-mainnet.json after deploy
VAULT_ADDRESS=0x...

# ── X Layer MAINNET ─────────────────────────────────────────────────────────
RPC_URL=https://rpc.xlayer.tech
CHAIN_ID=196

# ── Mainnet token addresses ──────────────────────────────────────────────────
BASE_TOKEN=0x5A77f1443D16ee5761d310e38b62f77f726bC71c
STABLE_TOKEN=0x74b7F16337b8972027F6196A17a631aC6dE26d22
BASE_SYMBOL=ETH
STABLE_SYMBOL=USDC

# ── Agent Config ─────────────────────────────────────────────────────────────
LOOP_INTERVAL_MS=15000
PREMIUM_COLLECT_EVERY_N=20
STATUS_PORT=3001
FORCE_COMPOUND_EVERY_N=2

# After seeding a policy on mainnet, paste policyId here
POLICY_ID=0x...

COINGECKO_API_KEY=
DEMO_MODE=false
