# SHIELD Agent Environment Variables
# Copy this to .env and fill in your values

# ── OnchainOS API credentials (get from OKX Web3) ──────────────────────────
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase

# ── Wallet (your Agentic Wallet private key) ────────────────────────────────
PRIVATE_KEY=0x...
AGENT_WALLET=0x...

# ── Deployed contract addresses (from contracts/deployments.json) ───────────
VAULT_ADDRESS=0x...

# ── X Layer Network ─────────────────────────────────────────────────────────
RPC_URL=https://testrpc.xlayer.tech
CHAIN_ID=195

# ── Token Addresses (X Layer testnet) ───────────────────────────────────────
BASE_TOKEN=0x5A77f1443D16ee5761d310e38b62f77f726bC71c
STABLE_TOKEN=0x74b7F16337b8972027F6196A17a631aC6dE26d22
BASE_SYMBOL=ETH
STABLE_SYMBOL=USDC

# ── Agent Config ─────────────────────────────────────────────────────────────
LOOP_INTERVAL_MS=15000
PREMIUM_COLLECT_EVERY_N=20
STATUS_PORT=3001

# Set to true for paper trading (no real onchainos binary required)
DEMO_MODE=true
